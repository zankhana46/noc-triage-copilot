# Copy to .env and fill in. Never commit .env.
#
# --- LLM (one OpenAI-compatible client for everything) ---
# Default: Google Gemini's free-tier OpenAI-compatible endpoint.
# Get a free API key at https://aistudio.google.com/apikey
LLM_API_KEY=your-gemini-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# gemini-3.8-flash's free tier is capped at 20 requests/day — far too low
# for this project's evaluation phases. gemini-3.5-flash-lite has its own,
# much larger free quota and is plenty capable for these structured tasks.
LLM_MODEL=gemini-3.5-flash-lite

# To point at a local vLLM server instead (Phase 5), swap these two:
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=/path/to/merged_model
# LLM_API_KEY=not-needed

# Optional: separate, smaller/faster model for cheap paraphrasing tasks
# (vendor message variety, runbook drafting) during data generation.
LLM_PARAPHRASE_MODEL=gemini-3.5-flash-lite

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# --- Reproducibility ---
SEED=42

# --- MLflow (local tracking) ---
# MLflow 3.x's filesystem store (./mlruns) is maintenance-mode only; a
# local SQLite backend is the current recommended default.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- ChromaDB (Phase 2) ---
CHROMA_PERSIST_DIR=./data/chroma
